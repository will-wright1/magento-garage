{
    "name": "automotive/module-garage",
    "description": "Customer vehicle garages, structured vehicle selection and product fitment for Magento 2.",
    "type": "magento2-module",
    "license": "proprietary",
    "keywords": [
        "magento2",
        "automotive",
        "garage",
        "vehicles"
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-mbstring": "*",
        "magento/framework": "^103.0",
        "magento/module-customer": "^103.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "magento/module-catalog": "^104.0",
        "magento/module-backend": "^102.0",
        "magento/module-catalog-inventory": "^100.0",
        "magento/module-store": "^101.0",
        "magento/module-config": "^101.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Automotive\\Garage\\": ""
        }
    },
    "scripts": {
        "test": "php Test/run.php",
        "validate-module": "php dev/validate.php"
    },
    "archive": {
        "exclude": [
            "/.github",
            "/Test",
            "/dev",
            "/.gitignore",
            "/.gitattributes"
        ]
    }
}
