<?php
/** @var \Automotive\Garage\Block\Shop\ProductList $block */
/** @var \Magento\Framework\Escaper $escaper */
$products = $block->getLoadedProductCollection();
?>
<?php if (!$products->count()): ?>
    <div class="message info empty"><p><?= $escaper->escapeHtml(__('No products are currently mapped to this vehicle. Contact us if you need help finding a part.')) ?></p></div>
<?php else: ?>
    <?= $block->getToolbarHtml() ?>
    <div class="products wrapper grid products-grid">
        <ol class="products list items product-items">
            <?php foreach ($products as $product): ?>
                <li class="item product product-item">
                    <div class="product-item-info">
                        <a class="product photo product-item-photo" href="<?= $escaper->escapeUrl($product->getProductUrl()) ?>" tabindex="-1">
                            <?= $block->getImage($product, 'category_page_grid')->toHtml() ?>
                        </a>
                        <div class="product details product-item-details">
                            <strong class="product name product-item-name"><a class="product-item-link" href="<?= $escaper->escapeUrl($product->getProductUrl()) ?>"><?= $escaper->escapeHtml($product->getName()) ?></a></strong>
                            <?= $block->getProductPrice($product) ?>
                            <a class="action primary" href="<?= $escaper->escapeUrl($product->getProductUrl()) ?>"><?= $escaper->escapeHtml(__('View product')) ?></a>
                        </div>
                    </div>
                </li>
            <?php endforeach; ?>
        </ol>
    </div>
    <?= $block->getChildBlock('toolbar')->setIsBottom(true)->toHtml() ?>
<?php endif; ?>
