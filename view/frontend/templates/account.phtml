                        </select>
                    </div>
                    <div class="field">
                        <label class="label" for="garage-registration"><?= $escaper->escapeHtml(__('Registration number')) ?></label>
                        <input class="input-text garage-registration-input" id="garage-registration" name="registration" type="text" value="<?= $escaper->escapeHtmlAttr((string) ($values['registration'] ?? '')) ?>" maxlength="30" <?= $block->isPlateRequired($country) ? 'required' : '' ?> autocomplete="off" autocapitalize="characters" spellcheck="false" aria-describedby="garage-registration-hint">
                        <div class="note" id="garage-registration-hint"><?= $escaper->escapeHtml(__('Use the issuing country and state for the plate, independently of vehicle specification.')) ?></div>
