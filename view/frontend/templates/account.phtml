                        <?php if ($vehicle->vin !== ''): ?><p><?= $escaper->escapeHtml(__('VIN / chassis ending %1', substr($vehicle->vin, -4))) ?></p><?php endif; ?>
                        <?php if ($vehicle->nickname !== ''): ?>
                            <p class="garage-nickname"><?= $escaper->escapeHtml($vehicle->nickname) ?></p>
                        <?php endif; ?>
                        <div class="garage-vehicle-actions">
                            <?php if ($vehicle->vehicleTypeId !== null): ?>
                                <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('garage/vehicle/shop')) ?>">
                                    <?= $block->getBlockHtml('formkey') ?>
                                    <input type="hidden" name="vehicle_id" value="<?= (int) $vehicle->id ?>">
                                    <button type="submit" class="action primary" aria-label="<?= $escaper->escapeHtmlAttr(__('Shop for vehicle %1', $vehicle->displayName())) ?>"><span><?= $escaper->escapeHtml(__('Shop for this vehicle')) ?></span></button>
                                </form>
                            <?php else: ?>
                                <a href="<?= $escaper->escapeUrl($block->getUrl('garage/account/index', ['id' => $vehicle->id, '_fragment' => 'garage-form-title'])) ?>"><?= $escaper->escapeHtml(__('Match vehicle to find parts')) ?></a>
                            <?php endif; ?>
                            <?php if (!$vehicle->isSelected): ?>
                                <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('garage/vehicle/select')) ?>">
                                    <?= $block->getBlockHtml('formkey') ?>
                                    <input type="hidden" name="vehicle_id" value="<?= (int) $vehicle->id ?>">
                                    <button type="submit" class="action primary" aria-label="<?= $escaper->escapeHtmlAttr(__('Select vehicle %1', $vehicle->displayName())) ?>"><span><?= $escaper->escapeHtml(__('Select vehicle')) ?></span></button>
                                </form>
                            <?php endif; ?>
                            <?php if (!$vehicle->isDefault): ?>
                                <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('garage/vehicle/defaultVehicle')) ?>">
                                    <?= $block->getBlockHtml('formkey') ?>
