            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="vehicle_id" value="<?= $escaper->escapeHtmlAttr((string) ($values['vehicle_id'] ?? '')) ?>">
            <fieldset class="fieldset">
                <legend class="legend"><span><?= $escaper->escapeHtml(__('Vehicle details')) ?></span></legend>
