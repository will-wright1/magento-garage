                    <div data-catalogue-fields hidden>
                        <?php foreach ($levels as $field): $label = ['make' => __('Make'), 'model' => __('Model'), 'year' => __('Model year'), 'variant' => __('Vehicle specification')][$field]; ?>
                            <div class="field required" data-field="<?= $escaper->escapeHtmlAttr($field) ?>"><label class="label" for="garage-catalogue-<?= $escaper->escapeHtmlAttr($field) ?>"><?= $escaper->escapeHtml($label) ?></label><select id="garage-catalogue-<?= $escaper->escapeHtmlAttr($field) ?>" data-level="<?= $escaper->escapeHtmlAttr($field) ?>" disabled><option value=""><?= $escaper->escapeHtml(__('Choose an option')) ?></option></select></div>
                        <?php endforeach; ?>
                    </div>
                    <p data-selector-status role="status" aria-live="polite"></p>
                    <div data-manual-fields>
                        <?php foreach ($levels as $field): ?>
                            <?php if ($field === 'year'): ?>
                                <div class="field" data-field="year"><label class="label" for="garage-year"><?= $escaper->escapeHtml(__('Model year')) ?></label><input class="input-text" id="garage-year" name="model_year" type="number" min="1886" max="2100" <?= $market === 'US' ? 'required' : '' ?> value="<?= $escaper->escapeHtmlAttr((string) ($values['model_year'] ?? '')) ?>"><p class="note"><?= $escaper->escapeHtml(__('Use model year, which may differ from the first registration year. Required for US-specification vehicles.')) ?></p></div>
                            <?php else: $required = $field !== 'variant'; $label = ['make' => __('Make'), 'model' => __('Model'), 'variant' => __('Variant / specification (optional)')][$field]; ?>
                                <div class="field<?= $required ? ' required' : '' ?>" data-field="<?= $escaper->escapeHtmlAttr($field) ?>"><label class="label" for="garage-<?= $escaper->escapeHtmlAttr($field) ?>"><?= $escaper->escapeHtml($label) ?></label><input class="input-text" id="garage-<?= $escaper->escapeHtmlAttr($field) ?>" name="<?= $escaper->escapeHtmlAttr($field) ?>" value="<?= $escaper->escapeHtmlAttr((string) ($values[$field] ?? '')) ?>" maxlength="<?= $field === 'variant' ? '160' : '100' ?>" <?= $required ? 'required' : '' ?>></div>
                            <?php endif; ?>
                        <?php endforeach; ?>
                    </div>
                </div>
                <div class="field"><label class="label" for="garage-nickname"><?= $escaper->escapeHtml(__('Nickname (optional)')) ?></label><input class="input-text" id="garage-nickname" name="nickname" type="text" value="<?= $escaper->escapeHtmlAttr((string) ($values['nickname'] ?? '')) ?>" maxlength="100"></div>
            </fieldset>
            <div class="actions-toolbar garage-form-actions">
                <div class="primary"><button class="action save primary" type="submit"><span><?= $escaper->escapeHtml($editing ? __('Save changes') : __('Add vehicle')) ?></span></button></div>
                <?php if ($editing): ?>
                    <div class="secondary"><a class="action" href="<?= $escaper->escapeUrl($block->getUrl('garage/account/index')) ?>"><?= $escaper->escapeHtml(__('Cancel editing')) ?></a></div>
                <?php endif; ?>
            </div>
        </form>
    </section>
</div>
