                            <?php foreach (\Automotive\Garage\Model\Market::US_REGIONS as $code => $label): ?><option value="<?= $escaper->escapeHtmlAttr($code) ?>" <?= $code === ($values['registration_region'] ?? '') ? 'selected' : '' ?>><?= $escaper->escapeHtml(__($label)) ?></option><?php endforeach; ?>
                        </select>
                        <p class="note"><?= $escaper->escapeHtml(__('Required when entering a US license plate. Leave blank for UK plates.')) ?></p>
                    </div>
                    <div class="field">
                        <label class="label" for="garage-vin"><?= $escaper->escapeHtml(__('VIN / chassis number (optional)')) ?></label>
                        <input class="input-text garage-registration-input" id="garage-vin" name="vin" maxlength="40" value="<?= $escaper->escapeHtmlAttr((string) ($values['vin'] ?? '')) ?>" autocomplete="off" autocapitalize="characters" spellcheck="false">
                        <label class="label" for="garage-vin-format"><?= $escaper->escapeHtml(__('VIN / chassis format')) ?></label>
                        <select id="garage-vin-format" name="vin_format"><option value="standard" <?= ($values['vin_format'] ?? 'standard') === 'standard' ? 'selected' : '' ?>><?= $escaper->escapeHtml(__('Modern 17-character VIN')) ?></option><option value="legacy" <?= ($values['vin_format'] ?? '') === 'legacy' ? 'selected' : '' ?>><?= $escaper->escapeHtml(__('Older / imported chassis number')) ?></option></select>
                        <p class="note"><?= $escaper->escapeHtml(__('Stored manually. No VIN decoding or registration lookup is performed.')) ?></p>
                    </div>
                </div>
