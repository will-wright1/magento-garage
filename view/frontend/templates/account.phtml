                            <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('garage/vehicle/delete')) ?>">
                                <?= $block->getBlockHtml('formkey') ?>
                                <input type="hidden" name="vehicle_id" value="<?= (int) $vehicle->id ?>">
                                <button type="submit" class="action secondary garage-remove" aria-label="<?= $escaper->escapeHtmlAttr(__('Remove vehicle %1', $vehicle->displayName())) ?>"><span><?= $escaper->escapeHtml(__('Remove')) ?></span></button>
                            </form>
                        </div>
                    </li>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
    </section>
    <section class="garage-form-section" aria-labelledby="garage-form-title">
        <h2 id="garage-form-title"><?= $escaper->escapeHtml($editing ? __('Edit vehicle') : __('Add a vehicle')) ?></h2>
