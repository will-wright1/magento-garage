                                    <button type="submit" class="action secondary" aria-label="<?= $escaper->escapeHtmlAttr(__('Make %1 your default vehicle', $vehicle->displayName())) ?>"><span><?= $escaper->escapeHtml(__('Make default')) ?></span></button>
                                </form>
                            <?php endif; ?>
