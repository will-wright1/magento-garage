                    <label class="label" for="garage-market"><?= $escaper->escapeHtml(__('Vehicle specification market')) ?></label>
                    <select id="garage-market" name="vehicle_market" required>
                        <?php foreach ($markets as $code => $label): ?><option value="<?= $escaper->escapeHtmlAttr($code) ?>" <?= $code === $market ? 'selected' : '' ?>><?= $escaper->escapeHtml(__($label)) ?></option><?php endforeach; ?>
