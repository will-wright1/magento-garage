                            <div class="garage-badges">
                                <?php if ($vehicle->isSelected): ?>
                                    <span class="garage-badge"><?= $escaper->escapeHtml(__('Selected')) ?></span>
                                <?php endif; ?>
                                <?php if ($vehicle->isDefault): ?>
                                    <span class="garage-badge garage-badge-default"><?= $escaper->escapeHtml(__('Default')) ?></span>
                                <?php endif; ?>
                            </div>
                        </div>
                        <h3><?= $escaper->escapeHtml($vehicle->make . ' ' . $vehicle->model) ?></h3>
                        <?php if ($vehicle->modelYear || $vehicle->variant !== ''): ?>
                            <p><?= $escaper->escapeHtml(trim(($vehicle->modelYear ?? '') . ' ' . $vehicle->variant)) ?></p>
                        <?php endif; ?>
