$market = $values['vehicle_market'] ?? 'GB';
$country = $values['registration_country'] ?? 'GB';
$levels = \Automotive\Garage\Model\Market::levels($market);
$markets = \Automotive\Garage\Model\Market::LABELS;
$selectorConfig = json_encode(['Automotive_Garage/js/vehicle-selector' => [
    'url' => $block->getUrl('garage/catalog/options'), 'market' => $market,
    'make' => $values['make'] ?? '', 'model' => $values['model'] ?? '',
    'year' => (string) ($values['model_year'] ?? ''), 'typeId' => (string) ($values['vehicle_type_id'] ?? ''),
    'preferCatalogue' => !$editing || !empty($values['vehicle_type_id']),
    'catalogueAvailable' => $block->hasVehicleCatalogue(), 'plateRequirement' => $block->plateRequirement(),
]], JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP | JSON_THROW_ON_ERROR);
?>
<div class="garage-account">
    <p><?= $escaper->escapeHtml(__('Save your vehicles here and choose the one you are shopping for.')) ?></p>
    <section class="garage-saved" aria-labelledby="garage-saved-title">
        <h2 id="garage-saved-title"><?= $escaper->escapeHtml(__('Your vehicles')) ?></h2>
        <?php if (!$vehicles): ?>
            <div class="message info empty"><p><?= $escaper->escapeHtml(__('Your garage is empty. Add your first vehicle below.')) ?></p></div>
        <?php else: ?>
            <ul class="garage-vehicles">
                <?php foreach ($vehicles as $vehicle): ?>
                    <li class="garage-vehicle<?= $vehicle->isSelected ? ' garage-vehicle-selected' : '' ?>">
