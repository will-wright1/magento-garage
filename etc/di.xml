    <virtualType name="AutomotiveGarageBadgeOptions" type="Automotive\Garage\Model\Config\Source\Options"><arguments><argument name="kind" xsi:type="string">badge</argument></arguments></virtualType>
    <type name="Automotive\Garage\Model\Garage">
        <arguments>
            <argument name="maxVehicles" xsi:type="number">50</argument>
            <argument name="vehicleTypes" xsi:type="object">Automotive\Garage\Model\ResourceModel\VehicleTypeStorage</argument>
