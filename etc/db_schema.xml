<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="automotive_garage_vehicle" resource="default" engine="innodb" comment="Customer Garage Vehicles">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Vehicle ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="registration" length="20" nullable="true" comment="Normalised Registration"/>
        <column xsi:type="varchar" name="vehicle_market" length="2" nullable="false" default="GB" comment="Vehicle Specification Market"/>
        <column xsi:type="varchar" name="registration_country" length="2" nullable="false" default="GB" comment="Plate Issuing Country"/>
        <column xsi:type="varchar" name="registration_region" length="2" nullable="false" default="" comment="US Plate Issuing Jurisdiction"/>
        <column xsi:type="varchar" name="registration_display" length="30" nullable="false" default="" comment="Display Plate Preserving Spacing"/>
        <column xsi:type="varchar" name="vin" length="40" nullable="true" comment="Optional VIN or Legacy Chassis Number"/>
        <column xsi:type="varchar" name="vin_format" length="10" nullable="false" default="standard" comment="Standard VIN or Legacy Chassis Format"/>
        <column xsi:type="varchar" name="make" length="100" nullable="false" comment="Customer Entered Make"/>
        <column xsi:type="varchar" name="model" length="100" nullable="false" comment="Customer Entered Model"/>
        <column xsi:type="varchar" name="nickname" length="100" nullable="false" default="" comment="Vehicle Nickname"/>
        <column xsi:type="int" name="vehicle_type_id" unsigned="true" nullable="true" comment="Canonical Vehicle Type"/>
        <column xsi:type="smallint" name="model_year" unsigned="true" nullable="true" comment="Model Year Snapshot"/>
        <column xsi:type="varchar" name="variant" length="160" nullable="false" default="" comment="Variant Snapshot"/>
        <constraint xsi:type="foreign" referenceId="GARAGE_VEHICLE_TYPE_FK" table="automotive_garage_vehicle" column="vehicle_type_id" referenceTable="automotive_garage_vehicle_type" referenceColumn="entity_id" onDelete="SET NULL"/>
        <column xsi:type="smallint" name="is_default" unsigned="true" nullable="false" default="0" comment="Default Vehicle"/>
        <column xsi:type="smallint" name="is_selected" unsigned="true" nullable="false" default="0" comment="Currently Selected Vehicle"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="entity_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="AUTOMOTIVE_GARAGE_VEHICLE_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="automotive_garage_vehicle" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="GARAGE_CUSTOMER_PLATE_JURISDICTION_UNQ"><column name="customer_id"/><column name="registration_country"/><column name="registration_region"/><column name="registration"/></constraint>
        <constraint xsi:type="unique" referenceId="GARAGE_CUSTOMER_VIN_UNQ"><column name="customer_id"/><column name="vin"/></constraint>
    </table>
    <table name="automotive_garage_vehicle_type" resource="default" engine="innodb" comment="Canonical Garage Vehicle Types">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Vehicle Type ID"/>
        <column xsi:type="varchar" name="market" length="2" nullable="false" default="GB" comment="Vehicle Specification Market"/>
        <column xsi:type="varchar" name="code" length="100" nullable="false" comment="Stable Merchant Vehicle Code"/>
        <column xsi:type="varchar" name="make" length="100" nullable="false" comment="Make"/>
        <column xsi:type="varchar" name="model" length="100" nullable="false" comment="Model"/>
        <column xsi:type="smallint" name="model_year" unsigned="true" nullable="false" comment="Model Year"/>
        <column xsi:type="varchar" name="variant" length="160" nullable="false" default="" comment="Variant Including Relevant Fitment Details"/>
        <column xsi:type="varchar" name="generation" length="80" nullable="false" default="" comment="Generation or Facelift"/>
        <column xsi:type="varchar" name="trim" length="80" nullable="false" default="" comment="Trim"/>
        <column xsi:type="varchar" name="engine" length="80" nullable="false" default="" comment="Engine Specification"/>
        <column xsi:type="varchar" name="body_style" length="80" nullable="false" default="" comment="Cab or Body Style"/>
        <column xsi:type="varchar" name="transmission" length="80" nullable="false" default="" comment="Transmission"/>
        <column xsi:type="varchar" name="fuel_type" length="10" nullable="false" default="" comment="fuel_type"/>
        <column xsi:type="varchar" name="steering" length="10" nullable="false" default="" comment="steering"/>
        <column xsi:type="varchar" name="drivetrain" length="10" nullable="false" default="" comment="drivetrain"/>
        <column xsi:type="int" name="wheelbase_mm" unsigned="true" nullable="true" comment="wheelbase_mm"/>
        <column xsi:type="int" name="bed_length_mm" unsigned="true" nullable="true" comment="bed_length_mm"/>
        <column xsi:type="smallint" name="is_enabled" unsigned="true" nullable="false" default="1" comment="Enabled for Selection"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="entity_id"/></constraint>
        <constraint xsi:type="unique" referenceId="GARAGE_TYPE_CODE_UNQ"><column name="code"/></constraint>
        <constraint xsi:type="unique" referenceId="GARAGE_TYPE_MARKET_DEFINITION_UNQ"><column name="market"/><column name="make"/><column name="model"/><column name="model_year"/><column name="variant"/></constraint>
    </table>
    <table name="automotive_garage_product_rule" resource="default" engine="innodb" comment="Explicit Product Fitment Coverage">
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="varchar" name="universal_market" length="3" nullable="false" default="GB" comment="Universal Fitment Market GB US or all"/>
        <column xsi:type="smallint" name="is_universal" unsigned="true" nullable="false" default="0" comment="Explicit Universal Fitment"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="product_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="GARAGE_RULE_PRODUCT_FK" table="automotive_garage_product_rule" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
    <table name="automotive_garage_product_fitment" resource="default" engine="innodb" comment="Product to Vehicle Type Fitment">
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="int" name="vehicle_type_id" unsigned="true" nullable="false" comment="Vehicle Type ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="product_id"/><column name="vehicle_type_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="GARAGE_FITMENT_PRODUCT_FK" table="automotive_garage_product_fitment" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="GARAGE_FITMENT_TYPE_FK" table="automotive_garage_product_fitment" column="vehicle_type_id" referenceTable="automotive_garage_vehicle_type" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="GARAGE_FITMENT_TYPE_IDX" indexType="btree"><column name="vehicle_type_id"/></index>
    </table>
</schema>
